# Mealie MCP Server Configuration

# URL of your Mealie instance (required)
MEALIE_URL=http://localhost:9925

# API key from Mealie (required)
# Generate at: Mealie Settings > API Tokens
MEALIE_API_KEY=your-api-key-here

# Comma-separated list of enabled tools (optional)
# If not set, all tools are enabled
# Available tools: list_recipes, get_recipe, create_recipe, update_recipe, delete_recipe,
#                  upload_recipe_image, list_foods, create_food, list_shopping_lists,
#                  get_shopping_list, add_shopping_list_item
ENABLED_TOOLS=
