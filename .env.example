# Mealie MCP Server Configuration

# URL of your Mealie instance (required)
MEALIE_URL=http://localhost:9925

# API key from Mealie (required)
# Generate at: Mealie Settings > API Tokens
MEALIE_API_KEY=your-api-key-here

# Comma-separated list of enabled tools (optional)
# If not set, all tools are enabled
ENABLED_TOOLS=

# Transport: 'stdio' (default, for local Claude Desktop) or 'http' (for remote/containerized deployment)
MCP_TRANSPORT=stdio

# HTTP transport only: port to listen on (default: 3000)
PORT=3000

# HTTP transport only: comma-separated allowed Host header values (DNS rebinding protection).
# Default: localhost,127.0.0.1. Add your NAS hostname/IP when deploying remotely, e.g.:
# ALLOWED_HOSTS=nas.local,192.168.1.50
ALLOWED_HOSTS=
