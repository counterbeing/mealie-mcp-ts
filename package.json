{
  "name": "mealie-mcp",
  "version": "1.0.7",
  "description": "MCP server for Mealie meal planning and recipe management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mealie-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": [
    "mcp",
    "mealie",
    "recipes",
    "meal-planning"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@vitest/ui": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.27.0"
}
